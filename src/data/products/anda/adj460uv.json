{
  "name": "ADJ-460UV",
  "type": "PCB UV Fluorescing Manual Inspection Conveyor",
  "image": "/images/products/anda/anda-adj460uv.png",
  "tagline": "",
  "intro": [
    {
      "t": "p",
      "text": "The Anda ADJ-460UV is an inspection station that allows manual/visual inspection of conformal coatings when applied to printed circuit board (PCB) assemblies using fluorescing ultraviolet UV lighting. This UV inspection station is equipped with a robust pin chain style conveyor that holds up to messy solvents and chemicals used in conformal coating, and easily transports heavy pallets/carriers for complex printed circuit board assembly applications."
    }
  ],
