          "items": [
            "2 valves can be accommodated in the standard machine",
            "PC with LCD monitors, keyboard and mouse",
            "Auto dipping and purging waste collection system",
            "LED UV lamps for inspection",
            "PCB clamping system",
            "ESD grounding point",
            "CE certified",
            "Heavy duty conveyor",
            "Dual lane conveyor system",
            "2 stage conveyor",
            "CCD vision camera",
            "2 nozzles simultaneous coating and tilt",
            "Material level detection",
            "Pallet return conveyor (underneath)",
            "Barcode or 2D code scanning system",
            "Material tank: 1 gal / 3 gal / 5 gal / 10 gal",
            "UPS and voltage stabilizer"
